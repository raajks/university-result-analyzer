# Database Connection
# For SQLite (default out-of-the-box local development):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production or Docker):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/university_result_analyzer?schema=public"

# Next.js Server Port
PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# University Portal Configurations
CCSU_PORTAL_URL="https://result.ccsuniversityweb.in/"
DEFAULT_UNIVERSITY="CCSU"

# Automation Engine Settings
# "mock" for zero-network testing; "interactive" for live Playwright browser with human CAPTCHA
RUNNER_DEFAULT_MODE="mock"
BROWSER_HEADLESS="false"
BROWSER_TIMEOUT_MS=60000

# Security & JWT Session
APP_SECRET="university-analyzer-secret-key-production-ready"

# Admin Authentication & Email OTP Verification
AUTHORIZED_ADMIN_EMAIL="rajkumarsharma705214@gmail.com"

# SMTP Mail Settings (Set your Gmail App Password to deliver real OTP emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="University Result Analyzer <no-reply@ccsu-analyzer.ac.in>"
